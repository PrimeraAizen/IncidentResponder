# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. API keys must never be committed.

# ---------------------------------------------------------------------------
# LLM provider (any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# openai = real OpenAI-compatible endpoint, fake = deterministic canned outputs (tests, no key needed)
LLM_PROVIDER=openai

# OpenAI:
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Gemini (OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=...
# LLM_MODEL=gemini-3.1-flash-lite     # the evaluated model; free tier: LLM_MAX_RPM=15, RUN_TIMEOUT_S=300

# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4o-mini

# Local Ollama (model must support tool calling, e.g. gpt-oss:20b, qwen3:14b).
# Ollama on another machine: set OLLAMA_HOST=0.0.0.0:11434 there and use its IP here.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=gpt-oss:20b
# LLM_REASONING_EFFORT=low      # reasoning models only: low | medium | high (fewer tokens = faster)

LLM_TIMEOUT_S=60
# Client-side cap on LLM requests per minute, for free tiers (gemini-3.1-flash-lite: 15). 0 = no cap.
LLM_MAX_RPM=0
# Longest pause between retries, even if the provider asks for more (429 "retry in 30s", 503 overloaded).
LLM_MAX_RETRY_WAIT_S=60

# ---------------------------------------------------------------------------
# Observability endpoints (as seen from the host, where the agents run)
# ---------------------------------------------------------------------------
PROM_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TOXIPROXY_URL=http://localhost:8474

# ---------------------------------------------------------------------------
# Agent limits (spec section 6.5)
# ---------------------------------------------------------------------------
MAX_TOOL_CALLS_PER_AGENT=4
MAX_LLM_CALLS_PER_AGENT=3
MAX_GRAPH_STEPS=25
# Whole investigation (soft limit; the report is "partial" if it is reached). With a low LLM_MAX_RPM, raise it.
RUN_TIMEOUT_S=180
MAX_VERIFY_LOOPS=2
TOOL_TIMEOUT_S=10
# Attempts per LLM/tool call (exponential backoff between attempts)
RETRY_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Postgres password used by the services (local demo only)
POSTGRES_PASSWORD=incident
# Steady background traffic generated by the loadgen container
LOADGEN_RPS=10
